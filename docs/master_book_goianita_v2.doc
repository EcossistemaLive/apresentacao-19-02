  body { font-family: 'Times New Roman', serif; font-size: 12pt; line-height: 1.5; margin: 2cm; }
  h1 { font-size: 16pt; font-weight: bold; text-align: center; margin-bottom: 24pt; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 18pt; border-bottom: 1px solid #000; padding-bottom: 6pt; }
  h3 { font-size: 13pt; font-weight: bold; margin-top: 12pt; }
  p { margin-bottom: 12pt; text-align: justify; }
  ul { list-style-type: disc; margin-bottom: 12pt; }
